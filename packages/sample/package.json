{
  "name": "mustard-sample",
  "private": true,
  "scripts": {
    "dev": "nodemon index.mts"
  },
  "type": "module",
  "nodemonConfig": {
    "delay": 500,
    "execMap": {
      "js": "node",
      "ts": "tsx",
      "mts": "tsx"
    },
    "ext": "ts,mts,js,mjs,json",
    "ignore": [
      "**/test/**",
      "**/docs/**",
      "node_modules"
    ],
    "verbose": true,
    "watch": [
      "*.ts",
      "*.mts",
      "*.js",
      "*.mjs"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.16.2",
    "chalk": "^5.2.0",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "catalog:"
  },
  "dependencies": {
    "mustard-cli": "workspace:*"
  },
  "version": null
}