{
  "name": "mustard-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter mustard-* build",
    "dev": "pnpm --filter mustard-cli dev",
    "release": "pnpm --filter mustard-cli publish --no-git-checks",
    "test": "pnpm --filter mustard-cli test -- -u"
  },
  "nodemonConfig": {
    "delay": 500,
    "env": {
      "NODE_ENV": "development"
    },
    "execMap": {
      "ts": "ts-node-esm"
    },
    "ext": "ts,json",
    "ignore": [
      "**/test/**",
      "**/docs/**",
      "node_modules"
    ],
    "restartable": "rs",
    "verbose": true,
    "watch": [
      "*.ts"
    ]
  },
  "prettier": {},
  "dependencies": {
    "@changesets/cli": "^2.27.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.20.2",
      "typescript": "5.4.5"
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}